# AWS credentials (uses default credential chain — configure via aws configure or env vars)
AWS_DEFAULT_REGION=us-east-1

# DynamoDB table for session storage (created by CloudFormation in production)
DYNAMODB_TABLE=aws-discovery-sessions

# Optional: Bedrock Knowledge Base ID for RAG augmentation
# KNOWLEDGE_BASE_ID=your-kb-id
# ── AWS CDS omnichannel engagement ──
# Sandbox: when true, channel adapters RECORD intended sends instead of calling
# AWS CDS. Leave true for local dev / demos without provisioned SES + SMS.
SANDBOX_MODE=true

# Amazon SES verified "From" address for the report email (real sends).
SES_SENDER_EMAIL=no-reply@example.com

# AWS End User Messaging origination identity (phone number id/ARN, pool id, or
# sender id) for SMS/RCS sends.
SMS_ORIGINATION_IDENTITY=

# Follow-up channel for the post-call message: sms or rcs.
FOLLOW_UP_CHANNEL=sms

# Optional RCS agent id (falls back to SMS_ORIGINATION_IDENTITY if unset).
# RCS_AGENT_ID=

# Demo fallback recipients used when a session has no captured contact details.
# Use your own test inbox / number. Example placeholders:
DEMO_EMAIL=you@example.com
DEMO_PHONE=+15550100000

# Model used for inbound intent routing + grounded answers (defaults to Nova Pro).
# INTENT_MODEL_ID=amazon.nova-pro-v1:0

# Conversation-state table + TTL (defaults to the sessions table / 30 days).
# CONVERSATION_TABLE=aws-discovery-sessions
# CONVERSATION_TTL_SECONDS=2592000
