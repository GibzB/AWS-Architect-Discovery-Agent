# Atlas Discovery — Environment Variables

# AWS Configuration
AWS_REGION=us-east-1
AWS_PROFILE=default

# DynamoDB
DYNAMODB_TABLE_NAME=atlas-discovery-dev-sessions

# S3
S3_REPORTS_BUCKET=atlas-discovery-dev-reports

# Bedrock
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
BEDROCK_VOICE_MODEL_ID=amazon.nova-sonic-v1:0

# Cognito
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Application
APP_ENV=development
LOG_LEVEL=DEBUG
